# ACEDEN AI OS — copy to .env
APP_ENV=development            # development | test | production
APP_NAME=Aceden AI OS
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./aceden_ai_os.db
# Required in production (32+ chars). Used later for credential encryption.
APP_SECRET_KEY=
ALLOWED_ORIGINS=               # comma-separated, optional

# Aceden connector (optional; set both or neither). https required in production.
ACEDEN_BASE_URL=
ACEDEN_API_KEY=
ACEDEN_TIMEOUT_SECONDS=10

# Auth
ACCESS_TOKEN_TTL_MINUTES=60
REMEMBER_ME_TTL_DAYS=30
JWT_ISSUER=aceden-ai-os

# After changing APP_SECRET_KEY, list the old value(s) here (comma-separated) until
# `python -m app.reencrypt` has been run; then remove them.
APP_SECRET_KEY_PREVIOUS=

# Connections: outbound calls to private/loopback/link-local hosts are blocked unless true (dev only).
ALLOW_PRIVATE_CONNECTOR_HOSTS=false
CONNECTION_TEST_COOLDOWN_SECONDS=5
# Outbound calls per connection per minute (Step 10.6); 0 = unlimited
CONNECTOR_MAX_CALLS_PER_MINUTE=120

# LLM (Step 5). "fake" is offline/test only and is rejected in production.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=40000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_REPAIRS=1             # extra attempts when structured output fails validation (0-3)
# Real provider: LLM_PROVIDER=openai_compatible works with OpenAI, Groq, Together, vLLM, etc.
LLM_BASE_URL=                  # e.g. https://api.openai.com/v1  (https required in production)
LLM_API_KEY=
INTENT_MIN_CONFIDENCE=0.5     # tool/goal intents below this confidence trigger a clarifying question

# Agent runs (Step 6.3): ceilings per run; callers may request less, never more.
AGENT_RUN_MAX_STEPS=8
AGENT_RUN_MAX_TOOL_CALLS=5
AGENT_RUN_MAX_LLM_CALLS=8
AGENT_RUN_TIMEOUT_SECONDS=120          # queue wait and each active stretch (5-3600)
AGENT_RUN_APPROVAL_WAIT_SECONDS=86400  # max wait on a human approval (60-604800)
PLAN_MAX_STEPS=8                       # ceiling on steps in one execution plan (1-20)
WORKFLOW_MAX_STEPS=10                  # ceiling on steps in one workflow definition (1-20)
WORKFLOW_MAX_DEFINITIONS=100           # ceiling on distinct workflows per workspace (1-1000)
WORKFLOW_MAX_ACTIVE_RUNS=20            # ceiling on pending/running workflow runs per workspace (1-200)
WORKFLOW_MAX_EVENT_FANOUT=10           # ceiling on workflow runs one event may start (1-50)
WORKFLOW_MAX_SCHEDULES=20              # ceiling on armed schedules per workspace (1-200)
WORKFLOW_TICK_MAX_SCHEDULES=20         # due schedules one scheduler tick fires (1-200)
WORKFLOW_TICK_MAX_RUNS=10              # scheduled/event runs one scheduler tick drives (1-100)
MEMORY_MAX_ITEMS=5000                  # ceiling on active memory items per workspace (1-100000)
MEMORY_MAX_PREFERENCES_PER_USER=50     # ceiling on one user's stored preferences (1-500)
MEMORY_MAX_DOCUMENT_CHARS=100000       # ceiling on one ingested document (1000-2000000)
MEMORY_MAX_CHUNKS_PER_DOCUMENT=100     # ceiling on chunks per document (1-500)
MEMORY_CHUNK_CHARS=1000                # target chunk size (200-4000)
MEMORY_RETRIEVAL_MAX_CHARS=8000        # ceiling on total memory text returned by one retrieval (500-100000)
MEMORY_PROMPT_MAX_CHARS=3000           # ceiling on memory text added to one model prompt (200-20000)
MEMORY_PROMPT_MAX_HITS=5               # ceiling on memory hits added to one model prompt (1-10)

# Authentication throttling and request size (14.1). 0 disables a limit (refused in production).
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_MAX_REQUESTS_PER_MINUTE=30
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_BYTES=4194304
